# ==============================================================================
# Social Connect — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or set variables in your container/CI.
# NEVER commit real secrets or credentials to source control.
# ==============================================================================

# --- Application & Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB) ---
# Local host: mongodb://localhost:27017/social-connect
# Docker Compose: mongodb://mongo:27017/social-connect
MONGODB_URI=mongodb://localhost:27017/social-connect
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# --- Client & CORS ---
# In development: http://localhost:5173
# In production: https://your-production-domain.example
CLIENT_URL=http://localhost:5173

# --- Authentication & JWT ---
# Required in production: Minimum 32-character high-entropy cryptographic strings
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters
JWT_SECRET=your_fallback_legacy_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN_MS=900000
EMAIL_VERIFICATION_EXPIRES_IN_MS=86400000

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=social-connect/posts

# --- Email Provider ---
# Options: 'mock' (in-memory test queue) or 'smtp' (production delivery)
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@socialconnect.local
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password

# --- Real-Time Socket.IO Rate Limiting ---
SOCKET_RATE_LIMIT_MAX=20
SOCKET_RATE_LIMIT_WINDOW_MS=10000

# --- OpenAPI / Swagger Documentation ---
# In development/test: Enabled by default at /api/docs
# In production: Set to 'true' to explicitly expose interactive Swagger UI
ENABLE_API_DOCS=false

# --- Observability, Logging & Error Tracking ---
# Slow request warning threshold in milliseconds (default: 500ms)
SLOW_REQUEST_THRESHOLD_MS=500
# Pluggable error tracking client (e.g. Sentry / Datadog DSN)
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=
# Internal metrics endpoint protection key (for GET /api/health/metrics)
METRICS_SECRET=your_secure_internal_metrics_api_key_here

# --- MongoDB Backup & Disaster Recovery ---
# Directory where local backup archives are staged
BACKUP_DIR=./backups
# Retention window for automated local backup archives in days
BACKUP_RETENTION_DAYS=7
# Storage destination ('local', 's3', 'gcs')
BACKUP_STORAGE_TARGET=local
